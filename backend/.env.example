# Pitch Deck Extractor – copy to .env and set values
# Required for embeddings and section classification:
COHERE_API_KEY=your_cohere_api_key_here

# Optional (defaults shown)
DATABASE_URL=mongodb://localhost:27017
DB_NAME=pitch_deck_db
INDEX_PATH=vector_index
PORT=3000
EMBEDDING_MODEL=embed-english-v3.0
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
FRONTEND_ORIGIN=http://localhost:5173
# Local Ollama stability (recommended defaults)
# - Max concurrent requests to Ollama (treat as a single compute resource)
OLLAMA_MAX_CONCURRENCY=1
# - Retries on transient network/timeouts (0..5)
OLLAMA_RETRIES=2
# - Client timeout in seconds; set 0 to disable timeout entirely
OLLAMA_TIMEOUT_SECS=0
# LLM_API_KEY=  # optional, for alternative LLM backends
